{define pingerScript}
<script src="{$basePath}/js/pinger.js?v7"></script>
{/define}

{define listPinger}
{include pingerScript}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    pingUserList({link AjaxApi:GetIpsPing , id => null});
  });
</script>
{/define}

{define ipPinger}
{include pingerScript}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    pingIPList({link AjaxApi:GetIpsPing , id => null});
  });
</script>
{/define}
