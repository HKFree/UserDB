{**
 * Grido s tlačítkem Vyhledat nahoře u filtrů. Výchozí šablona ho kreslí až pod tabulkou,
 * kde je u dlouhého seznamu mimo obrazovku, a výběr v rozbalovacím filtru se sám neodešle.
 *}
{extends $gridoTemplate}

{block customization}
    {php $form->getElementPrototype()->class[] = 'grido-search-top'}
{/block}

{block outerFilterControls}
    <button n:if="$formFilters" n:name="search" class="btn btn-primary btn-sm"><i class="fa fa-search" aria-hidden="true"></i> {$control->getTranslator()->translate('Grido.Search')}</button>
{/block}

{block search}{/block}
