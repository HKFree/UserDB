{block content}

<h3>Odeslání emailu <small>uživateli {if $canViewOrEdit}{$u->jmeno} {$u->prijmeni} {/if}({$u->nick})</small></h3>

{if $canViewOrEdit && $emailPlatny}
{include 'odesilatel.latte'}
{include '../form.latte', form => emailForm}
{elseif $canViewOrEdit}
<p class="alert alert-warning">
    E-mail nejde odeslat, člen nemá platnou e-mailovou adresu.
    Zadejte ji v <a n:href="Uzivatel:edit id => $u->id">editaci člena</a>.
</p>
{else}
<p>Na tuto operaci nemáte oprávnění!</p>
{/if}

{/block}

