{block content}
<h3>Kompletní seznam členů</h3>

{if $search}
  <p>Fulltextové vyhledávání: <code>{$search}</code></p>

{/if}
&nbsp;&nbsp;
{if $canViewOrEdit}
<a n:if="!$money" href="{link UzivatelList:listall search=>$search, money=>1}" class="btn btn-default btn-sm" role="button">Informace z money</a>
{/if}
<a n:if="$money" href="{link UzivatelList:listall search=>$search, money=>0}" class="btn btn-default btn-sm" role="button">Bez informací z money</a>

{if $vidiUdajeClenu}
<a n:if="$fullnotes" href="{link UzivatelList:listall search=>$search, fullnotes=>false}" class="btn btn-default btn-sm active" role="button" title="Zobrazit zkrácené poznámky a adresy"><i class="glyphicon glyphicon-check"></i> Kompletní poznámky a adresy</a>
<a n:if="!$fullnotes" href="{link UzivatelList:listall search=>$search, fullnotes=>true}" class="btn btn-default btn-sm" role="button" title="Zobrazit kompletní poznámky a adresy"><i class="glyphicon glyphicon-unchecked"></i> Kompletní poznámky a adresy</a>
{/if}

<br><br>


{control grid}

{if !$search}
<ul>
    <li>Počet zrušených členů: {$u_zrusenych}</li>
    <li>Počet primárních členů: {$u_primarnich}</li>
    <li>Počet řádných členů: {$u_radnych}</li>
    <li>Počet čestných členů: {$u_cestnych}</li>
    <li n:if="$money">Počet aktivních členů: {$u_aktivnich}</li>
    <li>Počet všech členů: {$u_celkem}</li>
    <li>Počet všech členů včetně zrušených: {$u_celkemz}</li>
</ul>
{/if}

{import '../pinger.latte'}
{include listPinger}
{/block}
