{import 'list.latte'}
{block title}Kompletní seznam členů{/block}
{block content}
<h3>Kompletní seznam členů</h3>

{if $search}
  <p>Fulltextové vyhledávání: <code>{$search}</code>
    <a href="{link UzivatelList:listall}" class="btn btn-default btn-xs" role="button"><i class="fa fa-times" aria-hidden="true"></i> Zrušit hledání</a></p>

{/if}
<div class="member-list">
<div class="list-toolbar">
{include memberQuickFilter}
<div class="list-view"><span>Zobrazit navíc:</span>
{if $canViewOrEdit}
<a n:if="!$money" href="{link UzivatelList:listall search=>$search, money=>1}" class="btn btn-default btn-sm money-toggle" role="button" aria-pressed="false"><i class="fa fa-square-o" aria-hidden="true"></i> Platby a aktivace</a>
{/if}
<a n:if="$money" href="{link UzivatelList:listall search=>$search, money=>0}" class="btn btn-default btn-sm active money-toggle" role="button" aria-pressed="true" title="Bez informací z money"><i class="fa fa-check-square-o" aria-hidden="true"></i> Platby a aktivace</a>

{if $vidiUdajeClenu}
<a n:if="$fullnotes" href="{link UzivatelList:listall search=>$search, fullnotes=>false}" class="btn btn-default btn-sm active" role="button" aria-pressed="true" title="Zobrazit zkrácené poznámky a adresy"><i class="fa fa-check-square-o" aria-hidden="true"></i> Kompletní poznámky a adresy</a>
<a n:if="!$fullnotes" href="{link UzivatelList:listall search=>$search, fullnotes=>true}" class="btn btn-default btn-sm" role="button" aria-pressed="false" title="Zobrazit kompletní poznámky a adresy"><i class="fa fa-square-o" aria-hidden="true"></i> Kompletní poznámky a adresy</a>
{/if}
</div>
</div>

<div class="user-list-scroll" tabindex="0" role="region" aria-label="Kompletní seznam členů">{control grid}</div>

{if !$search}{include memberStats}{/if}

{include memberLegend}
</div>

{import '../pinger.latte'}
{include listPinger}
{/block}
