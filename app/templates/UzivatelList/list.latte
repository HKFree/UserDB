{block title}{$ap->jmeno} - členové AP{/block}
{block content}
<nav aria-label="Drobečková navigace">
    <ol class="breadcrumb page-crumbs">
        <li><a n:href="Homepage:default">Přehled</a></li>
        <li><a n:href="Ap:list id=>$ap->Oblast->id">{$ap->Oblast->jmeno}</a></li>
        <li class="active" aria-current="page">{$ap->jmeno}</li>
    </ol>
</nav>
<div class="page-head">
<h1 class="page-title">{$ap->jmeno} <small>členové AP</small></h1>
<div class="page-actions">
<a href="{link Ap:show id=>$ap->id}" class="btn btn-default" role="button"><i class="glyphicon glyphicon-eye-open"></i> Podrobnosti AP</a>
<a href="{link Wewimo:show id=>$ap->id}" class="btn btn-default btn-sm" role="button"><i class="glyphicon glyphicon-signal"></i> Wewimo</a>
<a href="{link UzivatelMailSms:emailall id=>$ap->id}" class="btn btn-default" role="button"><i class="fa fa-envelope-o" aria-hidden="true"></i> E-mail všem</a>
<a href="{link UzivatelMailSms:smsall id=>$ap->id}" class="btn btn-default" role="button"><i class="glyphicon glyphicon-phone"></i> SMS všem</a>
<a href="{link Ap:ids id=>$ap->id}" class="btn btn-default btn-sm" role="button"><i class="fa fa-bug"></i> Události z IDS</a>

</div>
</div>
<div class="member-list" data-save-url="{link SpravaStitku:saveLabel id=>null}" data-delete-url="{link SpravaStitku:deleteLabel id=>null}">
<div class="list-toolbar">
{include memberQuickFilter}
<div class="list-view"><span>Zobrazit navíc:</span>
{if $canViewOrEdit}
<a n:if="!$money" href="{link UzivatelList:list id=>$ap->id, money=>1}" class="btn btn-default btn-sm money-toggle" role="button" aria-pressed="false" title="Zobrazit informace z money"><i class="fa fa-square-o" aria-hidden="true"></i> Platby a aktivace</a>
{/if}
<a n:if="$money" href="{link UzivatelList:list id=>$ap->id, money=>0}" class="btn btn-default btn-sm active money-toggle" role="button" aria-pressed="true" title="Skrýt informace z money"><i class="fa fa-check-square-o" aria-hidden="true"></i> Platby a aktivace</a>

<a n:if="$fullnotes" href="{link UzivatelList:list id=>$ap->id, fullnotes=>false}" class="btn btn-default btn-sm active" role="button" aria-pressed="true" title="Zobrazit zkrácené poznámky a adresy"><i class="fa fa-check-square-o" aria-hidden="true"></i> Celé poznámky a adresy</a>
<a n:if="!$fullnotes" href="{link UzivatelList:list id=>$ap->id, fullnotes=>true}" class="btn btn-default btn-sm" role="button" aria-pressed="false" title="Zobrazit kompletní poznámky a adresy"><i class="fa fa-square-o" aria-hidden="true"></i> Celé poznámky a adresy</a>
{include memberDensity}
</div>
</div>

{control grid}

{include memberStats}

{include memberLegend}
<section class="panel panel-default detail-panel">
<div class="panel-heading"><h4>Uživatelé mimo AP:</h4></div>
<div class="panel-body">
{control othersGrid}
</div>
</section>
</div>

{import '../pinger.latte'}
{include listPinger}
{/block}

{define memberStats}
<ul class="member-counts">
    <li>Počet zrušených členů: {$u_zrusenych}</li>
    <li>Počet primárních členů: {$u_primarnich}</li>
    <li>Počet řádných členů: {$u_radnych}</li>
    <li>Počet čestných členů: {$u_cestnych}</li>
    <li n:if="$money">Počet aktivních členů: {$u_aktivnich}</li>
    <li>Počet všech členů: {$u_celkem}</li>
    <li>Počet všech členů včetně zrušených: {$u_celkemz}</li>
</ul>
{/define}

{define memberDensity}
<span>Řádky:</span>
<span class="btn-group row-density" role="group" aria-label="Hustota řádků">
    <button type="button" class="btn btn-default btn-sm active" data-compact="0" aria-pressed="true">Pohodlné</button>
    <button type="button" class="btn btn-default btn-sm" data-compact="1" aria-pressed="false">Kompaktní</button>
</span>
{/define}

{define memberQuickFilter}
<div class="quick-filter">
    <label class="sr-only" for="member-quick-filter">Rychlý filtr v načtených řádcích</label>
    <i class="fa fa-filter" aria-hidden="true"></i>
    <input id="member-quick-filter" type="search" class="form-control input-sm" placeholder="Rychlý filtr: jméno, e-mail, IP, poznámka…" autocomplete="off">
    <span class="quick-filter-count" aria-live="polite"></span>
</div>
{/define}

{define memberLegend}
<div class="member-legend"><span>Legenda:</span>
    <span class="legend-chip planovane">Plánovaný člen</span>
    <span class="legend-chip primarni">Primární člen</span>
    <span class="legend-chip cestne">Čestný člen</span>
    <span class="legend-chip zrusene">Zrušený člen</span>
    <span class="legend-chip legend-overpaid" title="Vysoký přeplatek na účtu (vyřešte s uživatelem, nebo vyplňte mobilní kauci v detailu uživatele)" tabindex="0" data-toggle="tooltip">Vysoký přeplatek</span>
    <span class="legend-chip legend-inactive" title="Neaktivní člen (v závislosti na poslední platbě a poslední aktivaci zvažte zrušení členství)" tabindex="0" data-toggle="tooltip">Neaktivní člen</span>
</div>
{/define}

