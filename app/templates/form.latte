{default $grouped = false, $cancelLink = null}
<form n:name=$form n:class="$grouped ? member-form, $grouped && $form->isSubmitted() ? form-dirty">

    <ul class="error" n:if="$form->ownErrors" n:block="#errors">
        <li n:foreach="$form->ownErrors as $error">{$error}</li>
    </ul>

    {if $grouped}
        <section n:foreach="$form->getGroups() as $group" class="form-section" id="member-form-section-{$iterator->counter}" aria-labelledby="member-form-heading-{$iterator->counter}">
            <h2 id="member-form-heading-{$iterator->counter}">{$group->getOption('label')}</h2>
            <table class="form">
                <tr n:foreach="$group->getControls() as $field">
                    <th>{label $field /}{$field->required ? '<span class="red">*</span>'|noescape}</th>
                    <td>{input $field} <span n:if="$field->getErrors()" class="text-danger">{inputError $field}</span></td>
                </tr>
                {if $group->getOption('dynamicContainer')}
                    {include 'dynamic.latte', recordTemplate => 'ipform.latte', component => $form[$group->getOption('dynamicContainer')]}
                {/if}
            </table>
        </section>
        <div class="form-save-bar">
            {foreach $form->components as $component}
                {if $component instanceof \Nette\Forms\Controls\SubmitButton}{input $component}{/if}
            {/foreach}
            <a n:if="$cancelLink" href="{$cancelLink}" class="btn btn-link">Zrušit</a>
            <span class="form-status" role="status" aria-live="polite"></span>
            <span class="required-note"><span class="red">*</span> povinné pole</span>
        </div>
    {else}
    <table n:block="#controls" class="form">
        {foreach $form->components as $component}
            {if $component instanceof \Nette\Forms\Container}
                {* kontejner, obsluha nekterych specialnich pripadu *}
                {if $component->name =='ip'}
                    {include 'dynamic.latte', recordTemplate => 'ipform.latte', component => $component}
                {elseif $component->name =='subnet'}
                    {include 'dynamic.latte', recordTemplate => 'subnetform.latte', component => $component}
                {elseif $component->name =='apiKlic'}
                    {include 'dynamic.latte', recordTemplate => 'apiklicform.latte', component => $component}
                {else}
                    {* vychozi zpusob vypisu component uvnitr kontejneru *}
                    {foreach $component->controls as $field}
                        {label $field /}{$field->required ? '<span class="red">*</span>'|noescape} {input $field} <span n:if="$field->getErrors()" class="text-danger">{inputError $field}</span> <br />
                    {/foreach}
                {/if}
            {else}
                {* normalni ovladaci prvek ve formulari *}
                <tr>
                    <th>{label $component /}{$component->required ? '<span class="red">*</span>'|noescape}</th>
                    <td>{input $component} <span n:if="$component->getErrors()" class="text-danger">{inputError $component}</span></td>
                </tr>
            {/if}
        {/foreach}
    </table>
    {/if}

</form>
