{block title}{ifset $ap}{$ap->jmeno} - přístupový bod{else}Přístupový bod{/ifset}{/block}
{block content}
{ifset $ap}

<nav aria-label="Drobečková navigace">
    <ol class="breadcrumb page-crumbs">
        <li><a n:href="Homepage:default">Přehled</a></li>
        <li><a n:href="Ap:list id=>$ap->Oblast->id">{$ap->Oblast->jmeno}</a></li>
        <li class="active" aria-current="page">{$ap->jmeno}</li>
    </ol>
</nav>
<div class="page-head">
<h1 class="page-title"><s n:tag-if="!$ap->aktivni">{$ap->jmeno}</s> <small>přístupový bod</small> {if $ap->gps}<small class="ap-gps">GPS: {$ap->gps} <a href="http://mapa.hkfree.org/?lat={$ap->gps|replace:',','&lon='}">hkfree mapa</a> <a href="http://maps.google.com/maps?q={$ap->gps|replace:',','+'}">google mapa</a></small>{/if}</h1>
<div class="page-actions">
{if $canViewOrEdit}
<a href="{link Ap:edit id=>$ap->id}" class="btn btn-primary" role="button"><i class="glyphicon glyphicon-pencil icon-pencil"></i> Editovat</a>
{/if}
<a href="{link UzivatelList:list id=>$ap->id}" class="btn btn-default btn-sm" role="button"><i class="glyphicon glyphicon-user"></i> Zobrazit účastníky</a>
</div>
</div>
{* Odkaz na seznam clenu AP uz je v hlavicce: levy panel se zvyrazni hned, ne az po nacteni cele stranky. *}
<script>if (window.userdbSidebarTree) userdbSidebarTree();</script>
<p n:if="$ap->ulice_cp || $ap->spravce_neaktivni">
    <span n:if="$ap->ulice_cp"><b>Adresa AP:</b> {$ap->ulice_cp}, {$ap->mesto}, {$ap->psc}</span>
    <br n:if="$ap->ulice_cp && $ap->spravce_neaktivni">
    <small n:if="$ap->spravce_neaktivni" class="text-muted">Správce neaktivní</small>
</p>

<pre>
{$ap->poznamka}
</pre>
<br>

<section class="panel panel-default detail-panel">
<div class="panel-heading"><h4>Přehledy subnetů použitých na AP</h4></div>
<div class="panel-body">
{foreach $csubnety as $cs}
    <p><a href="{link Subnet:overview id=>$cs}" class="btn btn-default btn-sm" role="button"> Zobrazit subnety {$cs}</a> <a href="{link Subnet:detail id=>$cs}" class="btn btn-default btn-sm" role="button"> Zobrazit ip {$cs}</a></p>
{/foreach}
</div>
</section>

<section class="panel panel-default detail-panel detail-ip-table">
<div class="panel-heading"><h4>IP Adresy <small>na AP</small></h4></div>
<div class="panel-body">
<div class="table-responsive">{$adresy}</div>
</div>
</section>

{import '../pinger.latte'}
{include ipPinger}

<section class="panel panel-default detail-panel">
<div class="panel-heading"><h4>Subnety <small>na AP</small></h4></div>
<div class="panel-body">
{$subnety}
</div>
</section>

<section class="panel panel-default detail-panel">
<div class="panel-heading"><h4>API klíče <small>pro přístup k datům na AP přes REST API, postup viz <a href="https://github.com/HKFree/UserDB#accessing-api">GitHub</a></small></h4></div>
<div class="panel-body">
<table class="table table-striped">
    <tr>
        <th>Uživatelské jméno</th>
        <th>Klíč (heslo)</th>
        <th>Platnost do</th>
        <th>Poznámka</th>
    </tr>
{foreach $apiKlice as $apiKlic}
    <tr>
        <td>apikey{$apiKlic['id']}</td>
        <td>{$apiKlic['klic']}</td>
        <td>{$apiKlic['plati_do']|date:'d.m.Y'}{if $apiKlic['expired']} <span class="text-danger glyphicon glyphicon-warning-sign" aria-hidden="true"></span>{/if}</td>
        <td>{$apiKlic['poznamka']}</td>
    </tr>
{/foreach}
</table>
</div>
</section>

<details class="panel panel-default detail-panel log-panel">
<summary class="panel-heading"><span class="log-title">Historie změn</span></summary>
<div class="panel-body">
{control logTable, $ap->id, "ap"}
</div>
</details>

{/ifset}
{/block}
