<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{ifset #title}{include title|striptags} | {/ifset}HKFree UserDB</title>
    <link rel="stylesheet" href="{$basePath}/css/screen.css?v61">
    <link rel="stylesheet" media="print" href="{$basePath}/css/print.css">
    <link rel="icon" href="{$basePath}/favicon.ico">
</head>

<body>
<main class="standalone">
    {if $stav}
        {if $uzivatel->spolek}
            <h1>Vaše registrace do hkfree.org z.s. byla úspěšně dokončena.</h1>
            {* TODO pořešit registrační formulář podle nových stanov 2/2025 *}
            {* <p>Na váš e-mail byl právě odeslán registrační formulář, ve kterém naleznete všechny potřebné informace.</p> *}
        {elseif $uzivatel->druzstvo}
            <h1>Ověření proběhlo úspěšně</h1>
            <p>Děkujeme za ověření emailové adresy u hkfree.org internetové družstvo.</p>
        {/if}
    {else}
        <h1>Chyba</h1>
        <p>Ověření nebylo možné dokončit.</p>
    {/if}

</main>
</body>
