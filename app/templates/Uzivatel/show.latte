{block title}{ifset $u}{if $canViewOrEdit}{$u->jmeno} {$u->prijmeni}{else}{$u->nick}{/if}{else}Člen{/ifset}{/block}
{block content}
{ifset $u}

    <nav aria-label="Drobečková navigace">
        <ol class="breadcrumb page-crumbs">
            <li><a n:href="Homepage:default">Přehled</a></li>
            <li><a n:href="Ap:list id=>$u->Ap->Oblast->id">{$u->Ap->Oblast->jmeno}</a></li>
            <li><a n:href="UzivatelList:list id=>$u->Ap->id">{$u->Ap->jmeno}</a></li>
            <li class="active" aria-current="page">{if $canViewOrEdit}{$u->jmeno} {$u->prijmeni}{else}{$u->nick}{/if}</li>
        </ol>
    </nav>
    {* Odkaz na seznam clenu AP uz je v hlavicce: levy panel se zvyrazni hned, ne az po nacteni cele stranky. *}
    <script>if (window.userdbSidebarTree) userdbSidebarTree();</script>
    <div class="page-head">
    <h1 class="page-title">{if $canViewOrEdit}{$u->jmeno} {$u->prijmeni} <small>{$u->nick} · UID {$u->id}</small>{else}{$u->nick}{/if}
        {include spolekDruzstvoLabelUzivatel $u}
        <span n:if="$u->systemovy" class="label label-danger">Systémový uživatel</span>
    </h1>
    <div class="page-actions">
    {if $canViewOrEdit}
    <a href="{link Uzivatel:edit id=>$u->id}" class="btn btn-primary" role="button"><i class="glyphicon glyphicon-pencil icon-pencil"></i> Editovat</a>
    <a href="{link UzivatelMailSms:email id=>$u->id}" class="btn btn-default" role="button"><i class="fa fa-envelope-o" aria-hidden="true"></i> E-mail</a>
    <a href="{link UzivatelMailSms:sms id=>$u->id}" class="btn btn-default" role="button"><i class="glyphicon glyphicon-phone"></i> SMS</a>
    {/if}
    <div n:if="$canViewOrEdit || $u->regform_downloaded_password_sent==0" class="btn-group">
    <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Další <span class="caret"></span></button>
    <ul class="dropdown-menu dropdown-menu-right" role="menu" aria-label="Další akce člena">
    {if $canViewOrEdit}
        <li role="presentation"><a n:href="UzivatelRightsCc:editrights id=>$u->id" role="menuitem"><i class="glyphicon glyphicon-cog"></i> Editovat oprávnění</a></li>
        <li n:if="$u->spolek" role="presentation"><a n:href="UzivatelRightsCc:editcc id=>$u->id" role="menuitem"><i class="glyphicon glyphicon-asterisk"></i> Editovat čestné členství</a></li>
        <li role="presentation"><a href="https://aweg3.maternacz.com/profil/index.php" role="menuitem"><i class="glyphicon glyphicon-arrow-right"></i> SMS Comverga</a></li>
    {/if}
    {if $u->regform_downloaded_password_sent==0}
    <li role="presentation"><a n:href="UzivatelActions:sendRegActivation id=>$u->id" role="menuitem"><i class="fa fa-envelope-o" aria-hidden="true"></i> Odeslat znovu aktivační link e-mailem</a></li>
    {else}
    {* TODO předělat registrační form spolku podle nových stanov 2/2025 *}
    {* <a n:href="UzivatelActions:exportAndSendRegForm id=>$u->id" role="button" class="btn btn-default btn-sm"><b>@</b> Odeslat registrační formulář e-mailem</a> *}
    {/if}
    </ul>
    </div>
    </div>
    </div>

    <section class="member-labels" aria-label="Štítky člena">
            <b>Štítky:</b>
            {control userLabels userId => $u->id}
    </section>

    {if $canViewOrEdit}
    <div class="fact-strip" role="group" aria-label="Souhrn stavu člena">
        <a href="#member-internet" n:class="fact-tile, $money_act === 'ANO' ? ($money_dis === 'ANO' ? fact-warn : fact-ok) : fact-bad"><span>Internet</span><b>{if $money_act === 'ANO'}Aktivní{else}Neaktivní{/if}</b><small n:if="$money_dis === 'ANO'">deaktivace naplánována</small></a>
        <a href="#member-payments" n:class="fact-tile, substr((string) $money_bal_spolek, 0, 1) === '-' ? fact-bad"><span>Konto spolek</span><b>{$money_bal_spolek}{if is_numeric($money_bal_spolek)} Kč{/if}</b></a>
        <a href="#member-payments" n:class="fact-tile, $money_bal_druzstvo < 0 ? fact-bad"><span>Konto družstvo</span><b>{$money_bal_druzstvo} Kč</b></a>
        <a href="#member-tv" n:class="fact-tile, $televize_aktivni ? fact-ok : ($televize_objednana ? fact-warn)"><span>Televize</span><b>{if $televize_aktivni}Aktivní{elseif $televize_objednana}Objednaná{else}Neobjednaná{/if}</b><small n:if="$televize_aktivni && !$televize_objednana">odhlášená, doběhne</small><small n:if="$televize_objednana && !$televize_aktivni">zatím neaktivní</small></a>
        <a href="#member-contracts" class="fact-tile"><span>Smlouvy</span><b>{count($smlouvy) ?: 'Žádná'}</b></a>
        <a href="#member-ip" class="fact-tile"><span>IP adresy</span><b>{$ipCount ?: 'Žádná'}</b></a>
    </div>
    {/if}
    <div class="member-columns">
        <div class="panel-left">
        <section class="panel panel-default detail-panel" id="member-details">
        <div class="panel-heading"><h4>Detail informací</h4></div>
        <div class="panel-body">
    <table class="table table-nonfluid table-left">
	<tr>
            <th>Oblast - AP</th>
            <td><a n:href="Ap:list, id => $u->Ap->Oblast->id">{$u->Ap->Oblast->jmeno}</a> - <a n:href="Ap:show, id => $u->Ap->id">{$u->Ap->jmeno}</a></td>
        </tr>
        <tr n:if="$u->spolek">
            <th>Typ členství</th>
            <td>
                {if $u->TypClenstvi}
                    {if $hasCC}platné čestné členství{else}{$u->TypClenstvi->text}{/if}
                    <br>
                    {if $canViewOrEdit && $u->TypClenstvi->id > 1}
                    <a n:href="UzivatelActions:exportPdf id=>$u->id" role="button" class="btn btn-default btn-sm"><i class="glyphicon glyphicon-file icon-file"></i> Registrační formulář</a>
                    {/if}
                    {else}
                    n/a
                {/if}
            </td>
        </tr>

    <tr><th>Přezdívka</th><td>{$u->nick}</td></tr>
    {if $canViewOrEdit}
        <tr><th>Typ právní formy</th><td>{$u->TypPravniFormyUzivatele?->text}</td></tr>
        <tr n:if="$u->TypPravniFormyUzivatele?->text == 'PO'"><th>Název firmy</th><td>{$u->firma_nazev}</td></tr>
        <tr n:if="isset($u->firma_ico) || ($u->TypPravniFormyUzivatele?->text == 'PO')"><th>IČO</th><td>{$u->firma_ico}</td></tr>
        <tr><th>Číslo členské karty</th><td>{$u->cislo_clenske_karty}{include copyButton, value => $u->cislo_clenske_karty, what => 'číslo karty'}</td></tr>
        <tr><th>Jméno a příjmení</th><td>{$u->jmeno} {$u->prijmeni}</td></tr>
        <tr><th>Datum narození</th><td>{isset($u->datum_narozeni) ? $u->datum_narozeni->format('d.m.Y') : '-'}</td></tr>

        {var $hasLocation = $u->location_status == 'valid' || $u->location_status == 'approx'}
        <tr>
          <th>Ulice a č.p.</th>
          <td>{$u->ulice_cp}
            <a n:if="$hasLocation" href="{link Sprava:mapa id=>null}#uid{$u->id}" class="spacing-left"><i class="fa fa-map-marker" aria-hidden="true"></i> mapa</a>
            <span n:if="$u->location_status == 'unknown'" class="glyphicon glyphicon-exclamation-sign spacing-left" aria-hidden="true" title="Adresu nebylo možné automaticky převést na souřadnice! Opravte ji, prosím." data-toggle="tooltip" data-placement="top"></span>
          </td>
        </tr>
        <tr><th>Obec</th><td>{$u->mesto}</td></tr>
        <tr><th>PSČ</th><td>{$u->psc}</td></tr>
        <tr n:if="$hasLocation" title="GPS souřadnice jsou automaticky určeny z adresy." data-toggle="tooltip" data-placement="top">
          <th>GPS</th>
          <td>
            <span data-latitude="{$u->latitude}" data-longitude="{$u->longitude}" data-formatid="0" id="gpsCoords">{round($u->latitude*1e6)/1e6}, {round($u->longitude*1e6)/1e6}</span>
            <a class="spacing-left" href="#" id="gpsCoordsButton"><span class="glyphicon glyphicon-refresh" aria-hidden="true"></span>&nbsp;formát</a>
          </td>
        </tr>
        <tr><th>Email</th><td>{$u->email}{include copyButton, value => $u->email, what => 'e-mail'}</td></tr>
        <tr n:if="isset($u->email2)"><th>Sekundární email</th><td>{$u->email2}{include copyButton, value => $u->email2, what => 'sekundární e-mail'}</td></tr>
        <tr><th>Telefon</th><td>{$u->telefon}{include copyButton, value => $u->telefon, what => 'telefon'}</td></tr>
        <tr><th>Technologie připojení</th><td>{$u->TechnologiePripojeni->text}</td></tr>
        <!-- <tr><th>Způsob připojení</th><td>{$u->ZpusobPripojeni?->text}</td></tr> -->
        <tr><th>Poznámka</th><td>{$u->poznamka|breakLines}</td></tr>
        <tr><th>GPG klíč</th><td>{$u->gpg}</td></tr>
        <tr><th>Založen</th><td>{$u->zalozen}</td></tr>
        <!-- <tr><th>Kauce na mobilní tarify</th><td>{$u->kauce_mobil}</td></tr> -->

        <script src="{$basePath}/js/gps.js"></script>
        <script>
        $(document).ready(function() {
            $("#gpsCoordsButton").click(function() {
            rotateGPSFormat($("#gpsCoords"));
            });
        });
        </script>
    {/if}
    </table>
        </div>
        </section>

    {if $canViewOrEdit}
        <section class="panel panel-default detail-panel" id="member-payments">
        <div class="panel-heading">
        <h4>Platby
            &nbsp;
            <a n:href="PaymentSchedule:sendPaymentScheduleEmail id=>$u->id" role="button" class="btn btn-primary btn-sm" id="btn-handle-sendPaymentScheduleEmail" n:attr="data-confirm => $dotazRozpisPlateb">
                <b>@</b> Odeslat rozpis plateb e-mailem
            </a>
            <a n:href="PaymentSchedule:show id=>$u->id" class="btn btn-default btn-sm" role="button">
                náhled
            </a>
        </h4>
        </div>
        <div class="panel-body">
        <table class="table table-nonfluid">
            <tr>
                <th>Stav účtu</th>
                <td>
                    <table class="nested-payments">
                        <thead>
                            <tr>
                                <th>Spolek</th>
                                <th>Družstvo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>{$money_bal_spolek}</td>
                                <td>{$money_bal_druzstvo}</td>
                            </tr>
                            <tr>
                                <td nowrap>
                                    <a n:href="UzivatelAccount:account id=>$u->id, 'accountgrid-filter[ucet]'=>'spolek'">Přehled plateb</a>
                                </td>
                                <td nowrap>
                                    <a n:href="UzivatelAccount:account id=>$u->id, 'accountgrid-filter[ucet]'=>'druzstvo'">Přehled plateb</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
            <tr>
                <th>Poslední platba</th>
                <td>
                    <table class="nested-payments">
                        <tr>
                            <td>{if $money_lastpay_spolek === '?'}<span class="text-muted" title="Údaj není k dispozici">neznámé</span>{else}{$money_lastpay_spolek}{/if}</td>
                            <td>{if $money_lastpay_druzstvo === '?'}<span class="text-muted" title="Údaj není k dispozici">neznámé</span>{else}{$money_lastpay_druzstvo}{/if}</td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr n:if="$u->spolek"><th>Souhrn členských příspěvků od 1.11.2017</th><td>{$money_dph}</td></tr>

        </table>
        </div>
        </section>
    {/if}

    </div>
    <div class="panel-right">
        <section class="panel panel-default detail-panel" id="member-contracts">
        <div class="panel-heading">
        <h4>Smlouvy &nbsp;
            <a href="{link UzivatelActions:handleSubscriberContract id=>$u->id}" class="btn btn-primary btn-sm" id="btn-handle-subscriber-contract" role="button">
                <i class="glyphicon glyphicon-pencil icon-pencil"></i> Nová účastnická smlouva
            </a>
            <a href="{link UzivatelActions:handleSubscriberContractPreview id=>$u->id}" class="btn btn-default btn-sm" role="button">
                 náhled
            </a>
        </h4>
        </div>
        <div class="panel-body">
        {if count($smlouvy)}
        <table class="table table-nonfluid table-right">
        <tbody>
        <tr>
            <th>ID</th>
            <th>Typ</th>
            <th>Ze dne</th>
            <th>Stav</th>
        </tr>
        <tr n:foreach="$smlouvy as $smlouva">
            <td><a n:href="SpravaSmluv:show, id=>$smlouva->id">{$smlouva->id}</a></td>
            <td>{$smlouva->typ|firstUpper}</td>
            <td>{$smlouva->kdy_vygenerovano->format('d.m.Y')}</td>
            <td>{$smlouvaStavSluzba->getStav($smlouva)}</td>
        </tr>
        </tbody>
        </table>
        {else}
        <p class="section-empty">Zatím nic.</p>
        {/if}
        </div>
        </section>
        <section class="panel panel-default detail-panel" id="member-internet">
        <div class="panel-heading">
        <h4>
            Internet &nbsp;
            {if $activaceVisible}<a href="{link UzivatelActions:moneyActivate id=>$u->id}" class="btn btn-success btn-sm" role="button"><i class="glyphicon glyphicon-ok-circle"></i> Aktivace</a>{/if}
            {if $reactivaceVisible}<a href="{link UzivatelActions:moneyReactivate id=>$u->id}" class="btn btn-success btn-sm" role="button"><i class="glyphicon glyphicon-ok-circle"></i> Reaktivace</a>{/if}
            {if $deactivaceVisible}<a href="{link UzivatelActions:moneyDeactivate id=>$u->id}" class="btn btn-danger btn-sm" role="button"><i class="glyphicon glyphicon-remove-circle"></i> Deaktivace</a>{/if}
            <a n:if="$igw" href="{link Uzivatel:show id=>$u->id}" class="btn btn-default btn-sm active" role="button" title="Zobrazit stav na IGW"><i class="glyphicon glyphicon-check"></i> Zobrazit stav na IGW</a>
            <a n:if="!$igw" href="{link Uzivatel:show id=>$u->id, igw=>1}" class="btn btn-default btn-sm" role="button" title="Zobrazit stav na IGW"><i class="glyphicon glyphicon-unchecked"></i> Zobrazit stav na IGW</a>
        </h4>
        </div>
        <div class="panel-body">
        <table class="table table-nonfluid table-right">
        <tbody>
            <tr><th>Aktivní</th><td><span n:class="label, $money_act === 'ANO' ? label-success : label-default">{$money_act}</span></td></tr>
            <tr><th>Deaktivace</th><td>{$money_dis}</td></tr>
            <tr><th>Poslední aktivace</th><td>{if $money_lastact === '?'}<span class="text-muted" title="Údaj není k dispozici">neznámé</span>{else}{$money_lastact}{/if}</td></tr>
        </tbody>
        </table>
        </div>
        </section>
        <section class="panel panel-default detail-panel" id="member-tv">
        <div class="panel-heading">
        <h4>
            Televize &nbsp;
            {if !$televize_objednana}
            <a href="{link UzivatelTelevizeActions:subscribe id=>$u->id}" class="btn btn-primary btn-sm" id="btn-televize-objednat" role="button">
                <i class="glyphicon glyphicon-ok-circle"></i> Objednat
            </a>
            {else}
            {if !$televize_aktivni}
                {if $money_bal_druzstvo >= $televize_cena}
                <a href="{link UzivatelTelevizeActions:activate id=>$u->id}" class="btn btn-success btn-sm" id="btn-televize-aktivovat" role="button">
                    <i class="glyphicon glyphicon-ok-circle"></i> Aktivovat
                </a>
                {/if}
            {/if}
            <a href="{link UzivatelTelevizeActions:unsubscribe id=>$u->id}" class="btn btn-danger btn-sm" id="btn-televize-odobjednat" role="button">
                <i class="glyphicon glyphicon-remove-circle"></i> Odhlásit
            </a>
            {/if}
        </h4>
        </div>
        <div class="panel-body">
        <table class="table table-nonfluid table-right">
        <tbody>
            <tr>
                <th>Objednaná</th>
                <td>
                {if $televize_objednana}
                    <span class="label label-success" title="Služba televize je objednaná, pravidelně odečítat kredit, aktivovat-deaktivovat">ANO</span>
                {else}
                    <span class="label label-default">NE</span>
                {/if}
                </td>
            </tr>
            <tr>
                <th>
                    Cena
                </th>
                <td>
                    {$televize_cena} Kč/měsíc
                    <a href="{link UzivatelTelevize:edit id=>$u->id}" class="btn btn-default btn-sm" role="button"><i class="glyphicon glyphicon-pencil icon-pencil"></i> změnit cenu</a>
                </td>
            </tr>

            <tr>
                <th>Aktivní</th>
                <td>
                {if $televize_aktivni}
                    <span class="label label-success">ANO</span> <i>{$televize_aktivni_poznamka}</i> do: {$televize_aktivni_do|date:'j. n. Y'}
                {else}
                    <span class="label label-default">NE</span>
                {/if}
                </td>
            </tr>
        </tbody>
        </table>
        <a href="{link UzivatelTelevize:show id=>$u->id}">podrobnosti</a>
        <!--
        <div>
            <a href="{link Mailing:sendUserEmail variant=>ZpoplatneniTelevize2026,id=>$u->id}" class="btn btn-info btn-sm" role="button">
                <i class="glyphicon glyphicon-info-sign"></i> Odeslat email s aktivačním tlačítkem (MÁM ZÁJEM - NEMÁM ZÁJEM)
            </a>
            <a href="{link Mailing:previewUserEmail variant=>ZpoplatneniTelevize2026,id=>$u->id}" class="btn btn-default btn-sm" role="button">
                <i class="glyphicon glyphicon-info-sign"></i> náhled
            </a>
        </div>
        -->
        <script>
            $('#btn-televize-objednat').on('click', function(event) {
                const c = confirm("Objednání placené služby SledovaniTV.\n\nPokračovat?");
                if (c) {
                    // Ok
                } else {
                    // Cancel
                    event.preventDefault();
                }
            })
            $('#btn-televize-aktivovat').on('click', function(event) {
                if (!confirm("Aktivace služby SledovaniTV během 15 minut.\nZ uživatelského účtu bude strženo {$televize_cena} Kč.\n\nPokračovat?")) {
                    event.preventDefault();
                }
            })
            $('#btn-televize-odobjednat').on('click', function(event) {
                const c = confirm("Zrušení placené služby SledovaniTV. Televize pojede ještě do konce tohoto měsíce.\n\nPokračovat?");
                if (c) {
                    // Ok
                } else {
                    // Cancel
                    event.preventDefault();
                }
            })
        </script>
        </div>
        </section>

      </div>
    </div>
        <section class="panel panel-default detail-panel" id="member-ip" n:attr="data-copy-ips => $canViewOrEdit ? 'true' : null">
        <div class="panel-heading"><h4>IP Adresy</h4></div>
        <div class="panel-body">
        {if !$ipCount}
            <p class="section-empty">Zatím nic.</p>
        {else}
        {if $canViewOrEdit}
            <div class="table-responsive">{$adresy}</div>
        {else}
            <p>{$adresyline}</p>
        {/if}
        {/if}
        </div>
        </section>

        <section class="panel panel-default detail-panel">
        <div class="panel-heading"><h4>Události z IDS <small>za posledních 7 dní, max. 1000 záznamů</small></h4></div>
        <div class="panel-body">
        <div id="ids">
            Načítám...
        </div>
        </div>
        </section>

    {if $canViewOrEdit}
        <script>
            $(document).ready(function( $ ) {
                $("#logsHeader").click(function(){
                    $(".logstable").toggle();
                    $(this).attr('aria-expanded', $('.logstable').is(':visible') ? 'true' : 'false');
                });
                $(".logstable").hide();
            });

            $('#btn-handle-subscriber-contract').on('click', function(event) {
                const c = confirm("Nová účastnická smloua bude odeslána k podpisu na e-mail "+{$u->email}+".\n\n(e-mail dorazí během 2 minut)\n\nPokračovat?");
                if (c) {
                    // Ok
                } else {
                    // Cancel
                    event.preventDefault();
                }
            })

            // Bez data-confirm člen nemá platnou adresu a hlášku o tom ukáže server.
            $('#btn-handle-sendPaymentScheduleEmail').on('click', function(event) {
                const dotaz = $(this).attr('data-confirm');
                if (dotaz !== undefined && !confirm(dotaz)) {
                    event.preventDefault();
                }
            })

        </script>
        <section class="panel panel-default detail-panel">
        <div class="panel-heading"><h4><button type="button" class="btn btn-link logs-toggle" id="logsHeader" aria-expanded="false">Změny (kliknutím rozbalíte)</button></h4></div>
        <div class="panel-body">
        {control logTable, $u->id}
        </div>
        </section>

    {/if}

    {import '../pinger.latte'}
    {include ipPinger}

{/ifset}

<script>
$(function(){
    if ($('#ids')) {
        $.ajax({
            url : {link ids},
            type: 'GET',
            success: function(data){
                $('#ids').html(data);
            }
        });
    }
});

</script>
{/block}

{define copyButton, $value, $what}
<button n:if="$value !== null && (string) $value !== '' && (string) $value !== '-'" type="button" class="copy-button" data-copy-value="{$value}" title="Zkopírovat {$what}" aria-label="Zkopírovat {$what}"><i class="fa fa-clone" aria-hidden="true"></i></button>
{/define}
