{block title}{if $canViewOrEdit}{if $member}Úprava účastníka {$member->jmeno} {$member->prijmeni} UID {$member->id}{else}Nový účastník{/if}{else}Úprava účastníka{/if}{/block}
{block content}

{if $canViewOrEdit}
{var $memberForm = $presenter['uzivatelForm']}
<nav aria-label="Drobečková navigace">
    <ol class="breadcrumb page-crumbs">
        <li><a n:href="Homepage:default id=>null">Přehled</a></li>
        {if $member}
            <li><a n:href="Ap:list id=>$member->Ap->Oblast->id">{$member->Ap->Oblast->jmeno}</a></li>
            <li><a n:href="UzivatelList:list id=>$member->Ap->id">{$member->Ap->jmeno}</a></li>
            <li><a n:href="Uzivatel:show id=>$member->id">{$member->jmeno} {$member->prijmeni}</a></li>
            <li class="active" aria-current="page">Úprava</li>
        {else}
            <li class="active" aria-current="page">Nový účastník</li>
        {/if}
    </ol>
</nav>
<div class="page-head">
    <h1 class="page-title">{if $member}Úprava účastníka {$member->jmeno} {$member->prijmeni} <small>UID {$member->id}</small>{else}Nový účastník{/if}</h1>
    <div class="page-actions" n:if="$member">
        <a n:href="Uzivatel:show id=>$member->id" class="btn btn-default"><i class="fa fa-arrow-left" aria-hidden="true"></i> Zpět na detail</a>
    </div>
</div>
<div class="member-form-layout">
    {include '../form.latte', form => uzivatelForm, grouped => true, cancelLink => $member ? $presenter->link('Uzivatel:show', ['id' => $member->id]) : null}
    <nav class="form-nav" aria-label="Části formuláře">
        <span>Části formuláře</span>
        <a n:foreach="$memberForm->getGroups() as $group" href="#member-form-section-{$iterator->counter}">{$group->getOption('label')}</a>
    </nav>
</div>
<script>
    // Pod každou IP adresou formuláře se ukáže její podsíť, maska a brána, u neplatné adresy chyba.
    // Odpověď na starší dotaz, která dorazí po novějším, se zahodí (data-reqid).
    {
        const ipValidate = (ip) => /^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/.test(ip);

        const show = (prvek) => { prvek.style.display = ''; };
        const hide = (prvek) => { prvek.style.display = 'none'; };

        const ipAjaxCallback = (tbody, d) => {
            const details = tbody.querySelector('.ip.details');
            const errors = tbody.querySelector('.ip.errors');

            if (details.dataset.reqid !== String(d.reqid)) {
                // data jdouci moc pozde zahodime
                return;
            }

            if (d.error) {
                errors.textContent = d.error;
                show(errors);
                hide(details);
            } else {
                details.querySelector('.subnet').textContent = d.subnet;
                details.querySelector('.gateway').textContent = d.gateway;
                details.querySelector('.mask').textContent = d.mask;
                details.querySelector('.subnetlink').setAttribute('href', d.subnetLink);
                hide(errors);
                show(details);
            }
        };

        const ipRefresh = (input) => {
            const ip = input.value;
            const tbody = input.closest('tbody');
            const details = tbody.querySelector('.ip.details');

            const editSubnet = tbody.querySelector('.ip.editsubnet');
            const apid = document.getElementById('frm-uzivatelForm-Ap_id')?.value ?? '';
            editSubnet.querySelectorAll('a').forEach((odkaz) => odkaz.setAttribute('href', {link Ap:show , id => null} + "/" + apid));
            show(editSubnet);

            if (ipValidate(ip) === false) {
                const errors = tbody.querySelector('.ip.errors');
                show(errors);
                hide(details);
                errors.textContent = "Neplatná IP adresa";
                return;
            }

            const reqid = String(Number(details.dataset.reqid) + 1);
            details.dataset.reqid = reqid;

            const url = new URL({link AjaxApi:GetIpDetails , id => null}, window.location.href);
            url.searchParams.set('ip', ip);
            url.searchParams.set('reqid', reqid);
            url.searchParams.set('apid', apid);
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then((response) => {
                    if (response.ok === false) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then((d) => ipAjaxCallback(tbody, d))
                .catch((error) => console.warn('Údaje o IP adrese se nepodařilo načíst:', error));
        };

        document.querySelectorAll('.ip_adresa.ip').forEach((input) => {
            input.addEventListener('keyup', () => ipRefresh(input));
            input.addEventListener('click', () => ipRefresh(input));
            ipRefresh(input);
        });
    }
</script>

{else}
<p>Na tuto operaci nemáte oprávnění!</p>
{/if}

{/block}

