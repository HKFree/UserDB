{**
 * @param string   $basePath web base path
 * @param array    $flashes  flash messages
 *}
<!DOCTYPE html>
<html lang="cs" data-theme="{$vzhled}" data-theme-choice="{$vzhledVolba}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="{$vzhledVolba === auto ? 'light dark' : $vzhled}">

    {capture $pageTitle}{ifset #title}{include title|striptags}{/ifset}{/capture}
    {var $pageTitle = trim((string) preg_replace('~\s+~u', ' ', (string) $pageTitle))}
    <title>{if $pageTitle !== ''}{$pageTitle|noescape} | {/if}HKFree UserDB</title>

    <link rel="preload" href="{$basePath}/fonts/geist/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{$basePath}/css/screen.css?v61">
    {* Vzhled podle systému, stav postranního panelu a třída js se nastaví před vykreslením, aby stránka neproblikla.
       Skript stojí za styly záměrně: počká na ně, a obsah stránky se tak nikdy nerozvrhne bez CSS
       (měření šířky v testech by jinak mohlo proběhnout nad nestylovanou stránkou). *}
    <script>
        (() => {
            const root = document.documentElement;
            if (root.dataset.themeChoice === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches) root.dataset.theme = 'dark';
            if (localStorage.getItem('userdb-sidebar') === 'hidden') root.dataset.sidebar = 'hidden';
            root.classList.add('js');
        })();
    </script>
    <link rel="stylesheet" media="print" href="{$basePath}/css/print.css">
    <link rel="icon" href="{$basePath}/favicon.ico">
    <script src="{$basePath}/js/main.js?v32" defer></script>
    {block head}{/block}
    {import 'spolekdruzstvo.latte'}
</head>

<body class="app" data-base-path="{$basePath}" data-stitky-save-url="{link SpravaStitku:saveLabel id=>null}" data-stitky-delete-url="{link SpravaStitku:deleteLabel id=>null}">
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>

    {* Nástroje: nabídka v horní liště, napovídání v hledání i přehled na úvodní stránce. null je oddělovač. *}
    {var $toolLinks = [
        'Status:default' => 'Status AP',
        'SpravaGrafu:usersgraph' => 'Graf počtu účastníků',
        'VnejsiScanner:default' => 'Vnější scan veřejných IP',
        'SpravaCc:prehledcc' => 'Přehled platných čestných členství',
        'SpravaStitku:default' => 'Štítky',
        'separatorAccounts' => null,
        'SpravaUctu:ucty' => 'Aktuální stavy účtů',
        'SpravaPlateb:odchoziplatby' => 'Přehled odchozích plateb',
        'separatorAdvanced' => null,
        'Sprava:nastroje' => 'Pokročilé nástroje',
        'Winbox:default' => 'Otevírání Winboxu z prohlížeče',
        'separatorNews' => null,
        'Novinky:default' => 'Novinky',
    ]}
    {var $toolIcons = [
        'Status:default' => 'icon-globe',
        'SpravaGrafu:usersgraph' => 'icon-chart-line',
        'VnejsiScanner:default' => 'icon-shield',
        'SpravaCc:prehledcc' => 'icon-star',
        'SpravaStitku:default' => 'icon-tags',
        'SpravaUctu:ucty' => 'icon-landmark',
        'SpravaPlateb:odchoziplatby' => 'icon-arrow-left-right',
        'Sprava:nastroje' => 'icon-sliders-horizontal',
        'Winbox:default' => 'icon-terminal',
        'Novinky:default' => 'icon-megaphone',
    ]}
    {var $toolsCurrent = $presenter->isLinkCurrent('Status:*') || $presenter->isLinkCurrent('SpravaGrafu:*')
        || $presenter->isLinkCurrent('VnejsiScanner:*') || $presenter->isLinkCurrent('SpravaCc:*')
        || $presenter->isLinkCurrent('SpravaStitku:*') || $presenter->isLinkCurrent('SpravaUctu:*')
        || $presenter->isLinkCurrent('SpravaPlateb:*') || $presenter->isLinkCurrent('Sprava:nastroje')
        || $presenter->isLinkCurrent('Winbox:*') || $presenter->isLinkCurrent('Novinky:*')}
    {var $identity = $user->getIdentity()}

    <aside class="app-sidebar sidebar" id="oblasti" aria-label="Oblasti">
        <div class="sidebar-header">
            <a class="brand" href="{link Homepage:default id=>null}" aria-label="HKFree UserDB, přehled">
                <span class="brand-mark" aria-hidden="true"><i class="icon icon-radio-tower"></i></span>
                <span class="brand-text"><span class="brand-name">UserDB</span><span class="brand-domain">hkfree.org</span></span>
            </a>
        </div>

        <div class="sidebar-content">
            <div class="sidebar-group sidebar-filter" n:if="$mojeOblastiSkupiny || $oblasti">
                <label class="sr-only" for="sidebar-filter-input">Filtrovat oblasti a AP</label>
                <i class="icon icon-funnel" aria-hidden="true"></i>
                <input type="search" id="sidebar-filter-input" class="form-control" placeholder="Filtrovat oblasti a AP…" autocomplete="off" data-sidebar-filter>
            </div>
            <div class="sidebar-group" n:if="$mojeOblastiSkupiny">
                <h4 class="sidebar-heading">Moje oblasti</h4>
                {* AP oblasti stojí odsazená pod jejím jménem; oblast s jediným AP je na jednom řádku. *}
                <ul class="nav nav-sidebar sidebar-mine">
                    {foreach $mojeOblastiSkupiny as $skupina}
                        {if count($skupina['aps']) === 1}
                            <li n:foreach="$skupina['aps'] as $idap => $jmenoAp"><a n:href="UzivatelList:list id=>$idap">{$jmenoAp}</a></li>
                        {else}
                            <li><a n:href="Ap:list id=>$skupina['id']">{$skupina['jmeno']}</a>
                                <ul class="nav">
                                    <li n:foreach="$skupina['aps'] as $idap => $jmenoAp"><a n:href="UzivatelList:list id=>$idap">{$jmenoAp}</a></li>
                                </ul>
                            </li>
                        {/if}
                    {/foreach}
                </ul>
            </div>
            <div class="sidebar-group" n:if="$oblasti">
                <h4 class="sidebar-heading"><a href="{link UzivatelList:listall id=>NULL}">Všechny oblasti</a></h4>
                <ul class="nav nav-sidebar area-tree" id="oblastitree">
                    {foreach $oblasti as $idoblast => $o}
                        {var $apcka = $o->related('Ap.Oblast_id')->order("jmeno")}
                        {if count($apcka) == 1}
                            {var $ap = $apcka->fetch()}
                            <li><a n:href="UzivatelList:list id=>$ap->id"><s n:tag-if="!$ap->aktivni">{$ap->jmeno} ({$ap->id})</s></a></li>
                        {else}
                            <li>
                                <details>
                                    <summary><a n:href="Ap:list id=>$o->id">{$o->jmeno}</a></summary>
                                    <ul class="nav">
                                        {foreach $apcka as $idap => $theAp}
                                            <li><a n:href="UzivatelList:list id=>$theAp->id"><s n:tag-if="!$theAp->aktivni">{$theAp->jmeno} ({$theAp->id})</s></a></li>
                                        {/foreach}
                                    </ul>
                                </details>
                            </li>
                        {/if}
                    {/foreach}
                </ul>
            </div>
            <p class="sidebar-empty" id="sidebar-nomatch" role="status" hidden>Žádná oblast ani AP neodpovídá.</p>
        </div>

        <div class="sidebar-footer">
            <button type="button" class="sidebar-user" popovertarget="menu-uzivatel" aria-haspopup="true" aria-expanded="false">
                <span class="avatar" aria-hidden="true">{$identity->getNick()|substr:0,1|upper}</span>
                <span class="sidebar-user-text">
                    <span class="sidebar-user-name">{$identity->getNick()}</span>
                    <span class="sidebar-user-meta">UID {$identity->getId()}</span>
                </span>
                <i class="icon icon-chevrons-up-down" aria-hidden="true"></i>
            </button>
            <div id="menu-uzivatel" class="menu" popover>
                <div class="menu-label">
                    <span class="avatar" aria-hidden="true">{$identity->getNick()|substr:0,1|upper}</span>
                    <span class="sidebar-user-text">
                        <span class="sidebar-user-name">{$identity->getNick()}</span>
                        <span class="sidebar-user-meta">UID {$identity->getId()}</span>
                    </span>
                </div>
                <hr>
                <a href="{link Uzivatel:show id=>$identity->getId()}"><i class="icon icon-id-card" aria-hidden="true"></i> Můj profil</a>
                <a n:if="$demoPersonaUrl" href="{$demoPersonaUrl}" title="Teď se díváš jako {$demoPersonaName}"><i class="icon icon-venetian-mask" aria-hidden="true"></i> Změnit osobu</a>
                <hr>
                <div class="menu-heading" id="theme-menu-label">Vzhled</div>
                {* Skupina přepínačů: v pořadí klávesy Tab je jen vybraná volba, mezi volbami se chodí šipkami. *}
                <div id="theme-menu" class="theme-menu" role="radiogroup" aria-labelledby="theme-menu-label">
                    <button n:foreach="$vzhledVolby as $volba => $popisek" type="button" role="radio" class="theme-option" data-theme-choice="{$volba}" aria-checked="{$volba === $vzhledVolba ? 'true' : 'false'}" tabindex="{$volba === $vzhledVolba ? 0 : -1}"><i n:class="icon, $volba === light ? icon-sun : ($volba === dark ? icon-moon : icon-monitor)" aria-hidden="true"></i> {$popisek}</button>
                </div>
                <hr>
                <a href="{link Sprava:logout id=>null}"><i class="icon icon-log-out" aria-hidden="true"></i> Odhlášení</a>
            </div>
        </div>
    </aside>
    <div class="sidebar-backdrop" aria-hidden="true"></div>

    <div class="app-inset">
        <header class="app-topbar">
            <button type="button" class="topbar-icon sidebar-toggle" aria-controls="oblasti" aria-expanded="true" aria-keyshortcuts="Control+B Meta+B" title="Skrýt nebo zobrazit seznam oblastí (Ctrl+B)">
                <i class="icon icon-panel-left" aria-hidden="true"></i><span class="sr-only">Seznam oblastí</span>
            </button>
            <span class="topbar-separator" aria-hidden="true"></span>

            <a class="topbar-brand" href="{link Homepage:default id=>null}" aria-label="HKFree UserDB, přehled">
                <span class="brand-mark" aria-hidden="true"><i class="icon icon-radio-tower"></i></span>
                <span class="brand-name">UserDB</span>
            </a>

            <form n:name="searchForm">
                <i class="icon icon-search" aria-hidden="true"></i>
                <label n:name="search" class="sr-only">Hledat</label>
                <input n:name="search" aria-describedby="search-hint">
                <kbd class="search-key" aria-hidden="true">/</kbd>
                <div class="search-suggestions" hidden>
                    <div class="search-hint" id="search-hint" role="status">Zadejte účastníka, číslo smlouvy, IP adresu, oblast, AP či nástroj.</div>
                    <div id="search-options" role="listbox" aria-label="Návrhy hledání"></div>
                    <div class="search-help"><kbd>↑</kbd> <kbd>↓</kbd> výběr <kbd>Enter</kbd> otevřít <kbd>Esc</kbd> zavřít</div>
                </div>
            </form>

            <nav class="topbar-nav" aria-label="Hlavní nabídka">
                <a n:class="topbar-link, $presenter->isLinkCurrent('Homepage:*') ? active" href="{link Homepage:default id=>null}" n:attr="aria-current => $presenter->isLinkCurrent('Homepage:*') ? page"><i class="icon icon-layout-dashboard" aria-hidden="true"></i><span class="topbar-label">Přehled</span></a>
                <a n:if="$oblasti" n:class="topbar-link, $presenter->isLinkCurrent('UzivatelList:listall') ? active" href="{link UzivatelList:listall id=>null}" n:attr="aria-current => $presenter->isLinkCurrent('UzivatelList:listall') ? page"><i class="icon icon-users" aria-hidden="true"></i><span class="topbar-label">Účastníci</span></a>
                <a n:class="topbar-link, $presenter->isLinkCurrent('Sprava:mapa') ? active" href="{link Sprava:mapa id=>null}" n:attr="aria-current => $presenter->isLinkCurrent('Sprava:mapa') ? page"><i class="icon icon-map" aria-hidden="true"></i><span class="topbar-label">Mapa</span></a>

                <button type="button" n:class="topbar-link, $toolsCurrent ? active" popovertarget="menu-nastroje" aria-haspopup="true" aria-expanded="false">
                    <i class="icon icon-wrench" aria-hidden="true"></i><span class="topbar-label">Nástroje</span><i class="icon icon-chevron-down caret-icon" aria-hidden="true"></i>
                </button>
                <div id="menu-nastroje" class="menu" popover>
                    {foreach $toolLinks as $destination => $label}
                        {if $label !== null}
                            <a href="{link $destination id=>null}" n:attr="aria-current => $presenter->isLinkCurrent($destination) ? page"><i class="icon {$toolIcons[$destination]}" aria-hidden="true"></i> {$label}</a>
                        {else}
                            <hr>
                        {/if}
                    {/foreach}
                </div>

                <a class="btn btn-primary btn-sm topbar-add" href="{link Uzivatel:edit id=>null}"><i class="icon icon-user-plus" aria-hidden="true"></i><span class="topbar-label">Přidat účastníka</span></a>
            </nav>
        </header>

        <main class="app-main main" id="obsah" tabindex="-1">
            <div n:foreach="$flashes as $flash" class="alert alert-{ifset $flash->type}{$flash->type}{else}info{/ifset} flash" role="status">{$flash->message}</div>

            {include content, toolLinks => $toolLinks}
        </main>
    </div>

    {block scripts}
        <script src="{$basePath}/js/netteForms.js"></script>
    {/block}
</body>
</html>
