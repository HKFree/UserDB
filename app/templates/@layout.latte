{**
 * @param string   $basePath web base path
 * @param array    $flashes  flash messages
 *}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">

        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {capture $pageTitle}{ifset #title}{include title|striptags}{/ifset}{/capture}
        {var $pageTitle = trim((string) preg_replace('~\s+~u', ' ', (string) $pageTitle))}
        <title>{if $pageTitle !== ''}{$pageTitle|noescape} | {/if}HKFree UserDB</title>

        <link href="{$basePath}/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{$basePath}/css/font-awesome.min.css">
        <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
        <script src="{$basePath}/js/jquery.min.js"></script>
        <link rel="stylesheet" href="{$basePath}/css/jquery-ui.css" />
        <script src="{$basePath}/js/jquery-ui.min.js"></script>
        <!-- Include all compiled plugins (below), or include individual files as needed -->
        <script src="{$basePath}/js/bootstrap.min.js"></script>
        <!-- Bar Rating ( https://github.com/antennaio/jquery-bar-rating ) -->
        <script src="{$basePath}/js/jquery.barrating.min.js"></script>
        <script src="{$basePath}/js/jquery.bonsai.js"></script>
        <script src="{$basePath}/js/markerclusterer.js"></script>

        <link rel="stylesheet" media="screen,projection,tv" href="{$basePath}/css/grido.css">
        <link rel="stylesheet" media="screen,projection,tv" href="{$basePath}/css/screen.css?v23">
        <link rel="stylesheet" media="screen,projection,tv" href="{$basePath}/css/jquery.bonsai.css">
        <link rel="stylesheet" media="print" href="{$basePath}/css/print.css">
        <link rel="shortcut icon" href="{$basePath}/favicon.ico">
        <script src="{$basePath}/js/main.js?v9"></script>
	{block head}{/block}
    {import 'spolekdruzstvo.latte'}
</head>

<body class="with-navbar" data-stitky-save-url="{link SpravaStitku:saveLabel id=>null}" data-stitky-delete-url="{link SpravaStitku:deleteLabel id=>null}">
    {var $toolLinks = [
        'Status:default' => 'Status AP',
        'SpravaGrafu:usersgraph' => 'Graf počtu účastníků',
        'VnejsiScanner:default' => 'Vnější scan veřejných IP',
        'SpravaCc:prehledcc' => 'Přehled platných čestných členství',
        'SpravaStitku:default' => 'Štítky',
        'separatorAccounts' => null,
        'SpravaUctu:ucty' => 'Aktuální stavy účtů',
        'SpravaPlateb:odchoziplatby' => 'Přehled odchozích plateb',
        'separatorAdvanced' => null,
        'Sprava:nastroje' => 'Pokročilé nástroje',
        'Winbox:default' => 'Otevírání Winboxu z prohlížeče',
        'separatorNews' => null,
        'Novinky:default' => 'Novinky',
    ]}
    {var $toolsCurrent = $presenter->isLinkCurrent('Status:*') || $presenter->isLinkCurrent('SpravaGrafu:*')
        || $presenter->isLinkCurrent('VnejsiScanner:*') || $presenter->isLinkCurrent('SpravaCc:*')
        || $presenter->isLinkCurrent('SpravaStitku:*') || $presenter->isLinkCurrent('SpravaUctu:*')
        || $presenter->isLinkCurrent('SpravaPlateb:*') || $presenter->isLinkCurrent('Sprava:nastroje')
        || $presenter->isLinkCurrent('Novinky:*')}
    <div class="navbar navbar-inverse navbar-fixed-top" role="navigation">
      <div class="container-fluid">
        <div class="navbar-header">
          <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target=".navbar-collapse" aria-expanded="false">
            <span class="sr-only">Zobrazit menu</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
          </button>
          <button n:if="$mojeOblasti || $oblasti" type="button" class="sidebar-toggle" id="navareas" aria-controls="sidebar" aria-expanded="false"><i class="fa fa-bars" aria-hidden="true"></i> <span class="sidebar-toggle-text">Oblasti</span></button>
          <a class="navbar-brand" href="{link Homepage:default id=>null}">userdb.<span class="brand-domain">hkfree</span><span class="brand-tld">.org</span></a>
        </div>
        <form n:name="searchForm" role="search">
          <i class="fa fa-search" aria-hidden="true"></i>
          <label n:name="search" class="sr-only">Hledat</label>
          <input n:name="search" placeholder="Hledat člena, IP, oblast, AP…" autocomplete="off" aria-describedby="search-hint">
          <div class="search-suggestions" hidden>
            <div class="search-hint" id="search-hint" role="status">Zadejte člena nebo IP, oblast, AP či nástroj.</div>
            <div id="search-options" role="listbox" aria-label="Návrhy hledání"></div>
            <div class="search-help"><kbd>↑</kbd> <kbd>↓</kbd> výběr <kbd>Enter</kbd> otevřít <kbd>Esc</kbd> zavřít</div>
          </div>
        </form>
        <div class="navbar-collapse collapse">
          <ul class="nav navbar-nav navbar-menu">
            <li n:class="$presenter->isLinkCurrent('Homepage:*') ? active"><a href="{link Homepage:default id=>null}" n:attr="aria-current => $presenter->isLinkCurrent('Homepage:*') ? page">Přehled</a></li>
            <li n:if="$oblasti" n:class="$presenter->isLinkCurrent('UzivatelList:listall') ? active"><a href="{link UzivatelList:listall id=>null}" n:attr="aria-current => $presenter->isLinkCurrent('UzivatelList:listall') ? page">Členové</a></li>
            <li n:class="$presenter->isLinkCurrent('Sprava:mapa') ? active"><a href="{link Sprava:mapa id=>null}" n:attr="aria-current => $presenter->isLinkCurrent('Sprava:mapa') ? page">Mapa</a></li>
            <li n:class="dropdown, $toolsCurrent ? active">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Nástroje <span class="caret"></span></a>
                <ul class="dropdown-menu" id="navbar-tools">
                    {foreach $toolLinks as $destination => $label}
                        {if $label !== null}
                            <li><a href="{link $destination id=>null}">{$label}</a></li>
                        {else}
                            <li role="separator" class="divider"></li>
                        {/if}
                    {/foreach}
                </ul>
            </li>
            <li class="navbar-add"><a href="{link Uzivatel:edit id=>null}" title="Přidat uživatele"><i class="fa fa-plus" aria-hidden="true"></i> <span class="navbar-add-text">Přidat uživatele</span></a></li>
          </ul>
          <ul class="nav navbar-nav navbar-right navbar-account">
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"><i class="fa fa-user-circle-o" aria-hidden="true"></i> <span class="navbar-account-name">{$user->getIdentity()->getNick()} ({$user->getIdentity()->getId()})</span> <span class="caret"></span></a>
                <ul class="dropdown-menu">
                    <li><a href="{link Uzivatel:show id=>$user->getIdentity()->getId()}">Můj profil</a></li>
                    <li n:if="$demoPersonaUrl"><a href="{$demoPersonaUrl}" title="Teď se díváš jako {$demoPersonaName}">Změnit osobu</a></li>
                    <li role="separator" class="divider"></li>
                    <li><a href="{link Sprava:logout id=>null}">Odhlášení</a></li>
                </ul>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="container-fluid">
      <div class="row">
        <div class="sidebar" id="sidebar">
          <div n:if="$mojeOblasti || $oblasti" class="sidebar-filter">
            <label class="sr-only" for="sidebar-filter-input">Filtrovat oblasti a AP</label>
            <input type="search" id="sidebar-filter-input" class="form-control input-sm" placeholder="Filtrovat oblasti a AP…" autocomplete="off">
          </div>
          {if $mojeOblasti}
            <h4>Moje oblasti</h4>
            <ul class="nav nav-sidebar">
              {foreach $mojeOblasti as $idoblast => $jmenoOblasti}
                <li id="oblast-{$idoblast}"><a href="{link UzivatelList:list id=>$idoblast}">{$jmenoOblasti}</a></li>
              {/foreach}
            </ul>
          {/if}
          {if $oblasti}
            <h4><a href="{link UzivatelList:listall id=>NULL}">Všechny oblasti</a></h4>
            <ul class="nav nav-sidebar" n:if="$oblasti" id="oblastitree">
              {foreach $oblasti as $idoblast => $o}
                {var $apcka = $o->related('Ap.Oblast_id')->order("jmeno")}
                {if count($apcka) == 1}
                  {var $ap = $apcka->fetch()}
                  <li><a n:href="UzivatelList:list id=>$ap->id"><s n:tag-if="!$ap->aktivni">{$ap->jmeno} ({$ap->id})</s></a></li>
                {else}
                  <li><a n:href="Ap:list id=>$o->id">{$o->jmeno}</a>
                    <ul class="nav">
                    {foreach $apcka as $idap => $theAp}
                      <li><a n:href="UzivatelList:list id=>$theAp->id"><s n:tag-if="!$theAp->aktivni">{$theAp->jmeno} ({$theAp->id})</s></a></li>
                    {/foreach}
                    </ul>
                  </li>
                {/if}
              {/foreach}
            </ul>
          {/if}
          <p class="sidebar-nomatch" id="sidebar-nomatch" role="status" hidden>Žádná oblast ani AP neodpovídá.</p>
        </div>
        <div class="sidebar-backdrop"></div>
        <div class="main" id="obsah">
<!--          <h1 class="page-header">Dashboard</h1> -->
	  <script> document.documentElement.className+=' js' </script>

	  <div n:foreach="$flashes as $flash" class="h4 alert alert-{ifset $flash->type}{$flash->type}{elseifset $flash->type}info{/ifset}">
      {$flash->message}
    </div>

	  {include content, toolLinks => $toolLinks}
        </div>
      </div>
    </div>
	{block scripts}
    <script src="{$basePath}/js/netteForms.js"></script>
    <script src="{$basePath}/js/nette.ajax.js"></script>
    <script src="{$basePath}/js/grido.js"></script>
	{/block}
</body>
</html>
