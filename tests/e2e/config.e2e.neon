# Konfigurace pro E2E v CI (kopíruje se do app/config/config.local.neon)
parameters:
	maternaMexUser: 'x'
	maternaMexPass: 'x'
	googleMapsApiKey: 'x'
	withDummyData: true
	debug:
		fakeUser: false
	memberHost: moje.localhost
	pushEndpointy:
		- 'http://mockpush:9999' # mock push služba v E2E testu (docker-compose.e2e.yml)
	igw1IpCheckerUrl: http://localhost/
	igw2IpCheckerUrl: http://localhost/

http:
	proxy: null
