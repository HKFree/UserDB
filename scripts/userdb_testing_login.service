# Sign-in form of the shared testing server, see "Testing server" in readme.md.
# Installed on the server as /etc/systemd/system/userdb-testing-login.service.
[Unit]
Description=UserDB testing: sign-in form

[Service]
# An account of its own: the deploy account runs the code of pull requests and must not read the password hash.
DynamicUser=yes
StateDirectory=userdb-testing-login
# USERDB_TESTING_LOGIN_PASSWORD_HASH and USERDB_TESTING_LOGIN_COOKIE_DOMAIN, readable by root only.
EnvironmentFile=/etc/userdb-testing-login.env
Environment=PHP_CLI_SERVER_WORKERS=4
# A port below 1024: the deploy account cannot listen there and pose as this service while it is down.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Without the two options a PHP warning would be answered with 200, which the reverse proxy takes for a yes.
ExecStart=/usr/bin/php -d display_errors=0 -d display_startup_errors=0 -S 127.0.0.1:981 /usr/local/lib/userdb-testing-login/userdb_testing_login.php
Restart=always

[Install]
WantedBy=multi-user.target
