includes:
    - vendor/phpstan/phpstan-nette/extension.neon

parameters:
    level: 5
    stubFiles:
        - phpstan/replicator.stub
    phpVersion: 80200
    tmpDir: temp/phpstan
    paths:
        - app
        - bin/console
        - bin/create-user.php
        - tests
        - scripts
        - www
        - pdfGenerator/www
    scanDirectories:
        - lib/phpqrcode
