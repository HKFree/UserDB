includes:
    - vendor/phpstan/phpstan-nette/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 5
    stubFiles:
        - phpstan/replicator.stub
    phpVersion: 80200
    tmpDir: temp/phpstan
    paths:
        - app
        - bin/console
        - bin/create-user.php
        - tests
        - scripts
        - www
        - pdfGenerator/www
    scanDirectories:
        - lib/phpqrcode
    strictRules:
        # Vypnuté skupiny mají v současném kódu nálezy, viz issue #204.
        disallowedLooseComparison: false
        booleansInConditions: false
        requireParentConstructorCall: false
        disallowedEmpty: false
        disallowedShortTernary: false
        strictFunctionCalls: false
